<Project Sdk="Microsoft.NET.Sdk">

  <!-- Latency bench: a fake phone against the real CompanionServer, in-process; no phone, ADB or ViGEm needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mobilepad-latency-bench</AssemblyName>
    <RootNamespace>Mobilepad.Companion</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" />
  </ItemGroup>

</Project>
